# provider host environment (no secrets here; the credential and signer token live in 0600 files)
METACOIN_BASE=https://host-a.example:8443
METACOIN_CA=/etc/metacoin/ca.pem
METACOIN_DOMAIN=dom-a
METACOIN_SIGNER_URL=http://127.0.0.1:9440
METACOIN_SIGNER_TOKEN_FILE=/home/zhangd2/projects/metacoin/work/independent-machine-network-session/artifacts/hostconfig-sample/signer/token
METACOIN_X402_DISABLED=1
