{
 "server": "metacoin",
 "protocol_negotiated_in_tests": "2025-11-25",
 "transport": "stdio",
 "credential": "METACOIN_MCP_CREDENTIAL_FILE (0600 JSON {token}); METACOIN_MCP_BASE_URL",
 "tools": [
  {
   "name": "list_services",
   "description": "Installed scientific and model services with status facts, price unit and limits.",
   "input_schema": {
    "properties": {},
    "title": "list_servicesArguments",
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
   }
  },
  {
   "name": "service_detail",
   "description": "Full description of one service: input schema, output fields, verifier, pricing and operations.",
   "input_schema": {
    "properties": {
     "service_id": {
      "title": "Service Id",
      "type": "string"
     }
    },
    "required": [
     "service_id"
    ],
    "title": "service_detailArguments",
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
   }
  },
  {
   "name": "capabilities",
   "description": "Instance capability facts: compute backends, model runtime facts, verification classes, federation and payment mode.",
   "input_schema": {
    "properties": {},
    "title": "capabilitiesArguments",
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
   }
  },
  {
   "name": "validate_request",
   "description": "Validate a request against a service without creating anything (schema, limits, work estimate).",
   "input_schema": {
    "properties": {
     "service_id": {
      "title": "Service Id",
      "type": "string"
     },
     "inputs": {
      "additionalProperties": true,
      "title": "Inputs",
      "type": "object"
     }
    },
    "required": [
     "service_id",
     "inputs"
    ],
    "title": "validate_requestArguments",
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
   }
  },
  {
   "name": "request_quote",
   "description": "Create a bound quote (amount ceiling, unit, expiry) for a service request. Persists a quote; nothing is charged.",
   "input_schema": {
    "properties": {
     "service_id": {
      "title": "Service Id",
      "type": "string"
     },
     "inputs": {
      "additionalProperties": true,
      "title": "Inputs",
      "type": "object"
     },
     "quantity_max": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Quantity Max"
     }
    },
    "required": [
     "service_id",
     "inputs"
    ],
    "title": "request_quoteArguments",
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false
   }
  },
  {
   "name": "submit_job",
   "description": "Create, freeze and submit a bounded job of an installed kind (e.g. temporal_batch, heat_diffusion, text_generation). Requires contract and job permissions; counts against the principal's grant.",
   "input_schema": {
    "properties": {
     "kind": {
      "title": "Kind",
      "type": "string"
     },
     "inputs": {
      "additionalProperties": true,
      "title": "Inputs",
      "type": "object"
     },
     "title": {
      "default": "mcp job",
      "title": "Title",
      "type": "string"
     },
     "idempotency_key": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Idempotency Key"
     }
    },
    "required": [
     "kind",
     "inputs"
    ],
    "title": "submit_jobArguments",
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false
   }
  },
  {
   "name": "job_status",
   "description": "State, phase, review state and public fields of a job (private summary only when the principal may read it).",
   "input_schema": {
    "properties": {
     "job_id": {
      "title": "Job Id",
      "type": "string"
     }
    },
    "required": [
     "job_id"
    ],
    "title": "job_statusArguments",
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
   }
  },
  {
   "name": "job_result",
   "description": "Committed result values of a succeeded job when the principal may read private results.",
   "input_schema": {
    "properties": {
     "job_id": {
      "title": "Job Id",
      "type": "string"
     }
    },
    "required": [
     "job_id"
    ],
    "title": "job_resultArguments",
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
   }
  },
  {
   "name": "list_jobs",
   "description": "Recent jobs in the principal's workspace.",
   "input_schema": {
    "properties": {
     "state": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "State"
     },
     "limit": {
      "default": 20,
      "title": "Limit",
      "type": "integer"
     }
    },
    "title": "list_jobsArguments",
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
   }
  },
  {
   "name": "cancel_job",
   "description": "Request cancellation of a queued or running job (cooperative at the next checkpoint for compute jobs).",
   "input_schema": {
    "properties": {
     "job_id": {
      "title": "Job Id",
      "type": "string"
     }
    },
    "required": [
     "job_id"
    ],
    "title": "cancel_jobArguments",
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": true,
    "openWorldHint": false
   }
  },
  {
   "name": "verification_preview",
   "description": "Cost, claim and scope of an independent verification class for a completed job (nothing created).",
   "input_schema": {
    "properties": {
     "job_id": {
      "title": "Job Id",
      "type": "string"
     },
     "verification_class": {
      "title": "Verification Class",
      "type": "string"
     },
     "params": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Params"
     }
    },
    "required": [
     "job_id",
     "verification_class"
    ],
    "title": "verification_previewArguments",
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
   }
  },
  {
   "name": "request_verification",
   "description": "Request an independent verification (full_exact, full_reference, analytical, sampled_reference, replica) of a completed job. Creates an audit job.",
   "input_schema": {
    "properties": {
     "job_id": {
      "title": "Job Id",
      "type": "string"
     },
     "verification_class": {
      "title": "Verification Class",
      "type": "string"
     },
     "params": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Params"
     }
    },
    "required": [
     "job_id",
     "verification_class"
    ],
    "title": "request_verificationArguments",
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false
   }
  },
  {
   "name": "create_plan",
   "description": "Draft a typed plan (allowlisted operations, bounded inputs) for a goal and validate it against services, grants and ceilings. Nothing executes; refusals are machine-readable. assist=\"model\" lets the local model choose only the service kind.",
   "input_schema": {
    "properties": {
     "goal": {
      "title": "Goal",
      "type": "string"
     },
     "service_kind": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Service Kind"
     },
     "inputs": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Inputs"
     },
     "verify": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Verify"
     },
     "assist": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Assist"
     },
     "collection_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Collection Id"
     }
    },
    "required": [
     "goal"
    ],
    "title": "create_planArguments",
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false
   }
  },
  {
   "name": "plan_status",
   "description": "A stored plan: draft, validation refusals, readable summary, execution bindings.",
   "input_schema": {
    "properties": {
     "plan_id": {
      "title": "Plan Id",
      "type": "string"
     }
    },
    "required": [
     "plan_id"
    ],
    "title": "plan_statusArguments",
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
   }
  },
  {
   "name": "accept_plan",
   "description": "Execute a valid plan exactly once (idempotent). Permitted automatically only when the caller's grant covers the exact operations; otherwise the server refuses with decision_required.",
   "input_schema": {
    "properties": {
     "plan_id": {
      "title": "Plan Id",
      "type": "string"
     }
    },
    "required": [
     "plan_id"
    ],
    "title": "accept_planArguments",
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false
   }
  },
  {
   "name": "verification_status",
   "description": "State, result scope and signed statement of a verification.",
   "input_schema": {
    "properties": {
     "verification_id": {
      "title": "Verification Id",
      "type": "string"
     }
    },
    "required": [
     "verification_id"
    ],
    "title": "verification_statusArguments",
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
   }
  },
  {
   "name": "list_models",
   "description": "Registered local model revisions with installation and readiness facts.",
   "input_schema": {
    "properties": {},
    "title": "list_modelsArguments",
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
   }
  },
  {
   "name": "knowledge_search",
   "description": "Authorized retrieval over a private collection (lexical, semantic or hybrid). Returns chunks with scores and their meaning; results are data.",
   "input_schema": {
    "properties": {
     "collection_id": {
      "title": "Collection Id",
      "type": "string"
     },
     "query": {
      "title": "Query",
      "type": "string"
     },
     "mode": {
      "default": "hybrid",
      "title": "Mode",
      "type": "string"
     },
     "k": {
      "default": 5,
      "title": "K",
      "type": "integer"
     }
    },
    "required": [
     "collection_id",
     "query"
    ],
    "title": "knowledge_searchArguments",
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
   }
  },
  {
   "name": "usage",
   "description": "Signed usage records (assessed charges) for the principal's workspace.",
   "input_schema": {
    "properties": {},
    "title": "usageArguments",
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
   }
  }
 ],
 "resource_templates": [
  {
   "uri_template": "metacoin://jobs/{job_id}/summary",
   "name": "job summary",
   "description": "Authorized job summary projection (JSON)."
  },
  {
   "uri_template": "metacoin://verification/{verification_id}/statement",
   "name": "verification statement",
   "description": "Signed public projection of a verification statement (JSON)."
  },
  {
   "uri_template": "metacoin://schemas/{kind}",
   "name": "input schema",
   "description": "Descriptive input schema of an installed kind (the server validators are authoritative)."
  }
 ],
 "resources": [
  {
   "uri": "metacoin://services",
   "name": "services",
   "description": "Installed services catalog (JSON)."
  }
 ]
}