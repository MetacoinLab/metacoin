.env
*.pem
*.key
/secrets/
*receipt*
*password*
*screenshot*
*.JPG
*.png
__pycache__/
*.pyc

# local Claude Code settings
.claude/

# runtime ledger data (never commit a real ledger file)
protocol/ledger_data.jsonl

# attestation software signing key (NEVER commit a signing key)
protocol/attest_key.secret
*.secret

# external-verifier submissions are local artifacts, not committed (any directory)
submission.json
*submission*.json
# same-machine self-recompute submission files (named sub_<task-id>.json) are also local
# input artifacts, never committed (the canonical record is the ANCHORED ledger entry).
sub_*.json
# keep the tracked submission JSON Schema spec (not a local artifact; must stay versioned)
!protocol/verifier_submission.schema.json

# full-content ledger snapshots are local/publishable artifacts, NOT committed (any directory).
# (the TINY tip anchor protocol/ledger_anchor.json IS committed — see below; only full
# snapshots, which embed the entire ledger, are ignored.)
*snapshot*.json

# agent-verifier-result input artifacts are local inputs, NOT committed (the canonical
# record is the ANCHORED ledger entry, not the input file). The leading '*' catches ANY
# platform prefix (e.g. windows_/mac_) and versioned variants, while NOT shadowing the
# tracked tool protocol/agent_verifier.py (a .py with no "result" in its name).
*agent_verifier_result*.json
# also catch the batch agent-result file naming (e.g. spark_agent_result.json), which uses
# 'agent_result' rather than 'agent_verifier_result' and would otherwise escape the glob above.
*agent_result*.json

# work-molecule derived artifacts (v0): read-only assemblies of existing records into
# a single provenance unit — local artifacts, never committed (the canonical record
# is the ANCHORED ledger entry; the molecule is reconstructible from it at any time).
wm_*.json

# ACI reports (agent_concentration.py --report) are derived, reconstructible artifacts —
# local only, never committed (the module re-derives them from the ledger deterministically).
aci_report*.json

# 30-day simulated-economy artifacts (economy_demo.py): persistent state + final log —
# derived, deterministic, reconstructible local artifacts, never committed (the canonical
# record is the ANCHORED summary; simulated day indices, zero value, no token).
economy_state.json
economy_log.json

# metering reports (task_metering.py --all) are local measurement artifacts, never
# committed: timing is non-reproducible run to run, so the file cannot be re-derived
# by a clone (the canonical record is the ANCHORED metering-evidence ledger entry,
# which fixes the claim via report_hash + aggregate totals).
metering_report.json

# cut certificates (cut_certificate.py --build) are derived, deterministic,
# reconstructible local artifacts, never committed (the canonical record is the
# ANCHORED cut-certificate ledger entry; the certificate rebuilds byte-identically
# from the ledger at any time).
cut_cert*.json

# trust-vector catalogs (trust_vector.py --all) are derived, deterministic,
# reconstructible local artifacts, never committed (the canonical record is the
# ANCHORED trust-vector-catalog ledger entry; the catalog rebuilds byte-identically
# from the ledger + evidence bundle at any time).
tv_catalog*.json

# challenge/response artifacts (challenge_response.py) are EPHEMERAL local files:
# the challenge nonce and the response hashes live verbatim in the ANCHORED ledger
# record, and the full task result they prove possession of is deliberately never
# published — so these files are never committed (must stay ABOVE the evidence-
# bundle negation block, which is last on purpose; signed round evidence copies
# under protocol/evidence/ are re-included by that block).
challenge*.json
response*.json

# actor-identity PRIVATE keychains (actor_identity.py --generate) hold one-time
# signing SECRETS — NEVER commit them. The public declaration (actor_key*.json)
# is also a local artifact: the canonical record is the ANCHORED registration.
keychain*.json
actor_key*.json

# MetaStar Treasury state + Gate-3 request files are local, deterministic,
# replayable artifacts — the canonical records are the ANCHORED treasury config
# and lifecycle entries (zero-value Test-META accounting, simulated economy).
treasury_state.json
gate3_*.json

# ============================================================================
# PUBLISHED EVIDENCE BUNDLE (protocol/evidence/) — the deliberate EXCEPTION to
# every local-artifact ignore rule above. These are privacy-checked COPIES of
# the evidence files (submissions, metering report, catalogs, ACI report,
# economy log, cut certificate) published so a FRESH CLONE can mechanically
# rebuild and re-verify every layer with zero local-only inputs. The live
# runtime ledger (protocol/ledger_data.jsonl) stays ignored — third parties
# get the published snapshot instead. Negations must come LAST to win.
!protocol/evidence/
!protocol/evidence/**
