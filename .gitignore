.env
*.pem
*.key
/secrets/
*receipt*
*password*
*screenshot*
*.JPG
*.png
__pycache__/
*.pyc

# local Claude Code settings
.claude/

# runtime ledger data (never commit a real ledger file)
protocol/ledger_data.jsonl

# attestation software signing key (NEVER commit a signing key)
protocol/attest_key.secret
*.secret

# external-verifier submissions are local artifacts, not committed (any directory)
submission.json
*submission*.json
# keep the tracked submission JSON Schema spec (not a local artifact; must stay versioned)
!protocol/verifier_submission.schema.json

# full-content ledger snapshots are local/publishable artifacts, NOT committed (any directory).
# (the TINY tip anchor protocol/ledger_anchor.json IS committed — see below; only full
# snapshots, which embed the entire ledger, are ignored.)
*snapshot*.json
