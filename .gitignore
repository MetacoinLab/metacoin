.env
*.pem
*.key
/secrets/
*receipt*
*password*
*screenshot*
*.JPG
*.png
__pycache__/
*.pyc

# local Claude Code settings
.claude/

# runtime ledger data (never commit a real ledger file)
protocol/ledger_data.jsonl

# attestation software signing key (NEVER commit a signing key)
protocol/attest_key.secret
*.secret

# external-verifier submissions are local artifacts, not committed (any directory)
submission.json
*submission*.json
# same-machine self-recompute submission files (named sub_<task-id>.json) are also local
# input artifacts, never committed (the canonical record is the ANCHORED ledger entry).
sub_*.json
# keep the tracked submission JSON Schema spec (not a local artifact; must stay versioned)
!protocol/verifier_submission.schema.json

# full-content ledger snapshots are local/publishable artifacts, NOT committed (any directory).
# (the TINY tip anchor protocol/ledger_anchor.json IS committed — see below; only full
# snapshots, which embed the entire ledger, are ignored.)
*snapshot*.json

# agent-verifier-result input artifacts are local inputs, NOT committed (the canonical
# record is the ANCHORED ledger entry, not the input file). The leading '*' catches ANY
# platform prefix (e.g. windows_/mac_) and versioned variants, while NOT shadowing the
# tracked tool protocol/agent_verifier.py (a .py with no "result" in its name).
*agent_verifier_result*.json
# also catch the batch agent-result file naming (e.g. spark_agent_result.json), which uses
# 'agent_result' rather than 'agent_verifier_result' and would otherwise escape the glob above.
*agent_result*.json
